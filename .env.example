# Application
APP_ENV=development
APP_PORT=8001
DEBUG=true

# Comma-separated origins (Component 3 proxy + local frontend)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Rubric inference: heuristic | transformer
RUBRIC_INFERENCE_MODE=heuristic

# Hugging Face model id or local path (when RUBRIC_INFERENCE_MODE=transformer)
RUBRIC_MODEL_NAME=distilbert-base-uncased

# Optional path to fine-tuned rubric classifier weights (from scripts/train_rubric.py)
RUBRIC_MODEL_PATH=

# Audio
DEFAULT_SAMPLE_RATE=16000
HESITATION_MFCC_DELTA_THRESHOLD=8.0
FILLER_WORDS=um,uh,like,you know,basically,actually,kind of,sort of
